[MASTER]
# AGENTS.md forbids docstrings, so C0114/C0116 conflict with project style.
# R0914/R0912/R0915 fire on the deliberately non-recursive mod-pruning logic;
# splitting it risks the quarantine/rollback invariants it was written to hold.
disable=
    C0114,
    C0116,
    R0914,
    R0912,
    R0915
# pytest is installed in the test job, not the super-linter container.
ignored-modules=pytest